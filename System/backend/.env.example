# 环境配置
NODE_ENV=development
PORT=3000

# 数据库配置
MONGODB_URI=mongodb://192.168.0.78:27017/parking_admin

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# 跨域配置
CORS_ORIGIN=http://localhost:3001

# 日志配置
LOG_LEVEL=info

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# 数据模拟配置
SIMULATION_INTERVAL=60000