# 运行环境
NODE_ENV=development
PORT=5001

# 数据库配置
MONGODB_URI=mongodb://127.0.0.1:27017/parking_admin
UNIFIED_MONGODB_URI=mongodb://127.0.0.1:27017/parking_admin

# 跨库同步/兼容脚本使用的小程序端数据库地址
TCC_MONGODB_URI=mongodb://127.0.0.1:27017/parking_system

# 认证配置
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=24h

# 跨域配置
CORS_ORIGIN=http://localhost:5002

# 默认管理员初始化配置
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me
DEFAULT_ADMIN_NAME=系统管理员

# 小程序接口联调配置
TCC_API_URL=http://localhost:3001/api
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 日志配置
LOG_LEVEL=info

# 上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# 数据模拟配置
SIMULATION_INTERVAL=60000

# 功能开关
ENABLE_CHANGE_STREAMS=0
