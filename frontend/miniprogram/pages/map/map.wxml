<view class="container">
  <view class="header">
    <text class="title">停车场地图</text>
    <text class="free-spaces">空闲车位: {{freeSpaces}}</text>
  </view>

  <view class="map-container" style="height: {{mapHeight}}px;">
    <!-- Canvas渲染引擎地图 -->
    <canvas 
      wx:if="{{isUsingCanvas}}"
      id="parking-canvas"
      style="width: {{mapWidth}}px; height: {{mapHeight}}px; background-color: #f0f0f0;"
      type="2d"
      bindtap="selectSpace"
      bindtouchstart="onCanvasTouchStart"
      bindtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd"
    ></canvas>
    
    <!-- 传统View渲染（备用） -->
    <scroll-view wx:else class="parking-map" scroll-x="true" scroll-y="true" style="width: 100%; height: 100%;" scroll-left="{{scrollLeft}}" scroll-top="{{scrollTop}}">
      <view style="width: {{mapWidth}}px; height: {{mapHeight}}px; position: relative;">
        <view 
          wx:for="{{spaces}}" 
          wx:key="spaceId"
          class="parking-space {{item.status === 'available' ? 'free' : 'occupied'}} {{selectedSpace.spaceId === item.spaceId ? 'selected' : ''}}"
          data-space-id="{{item.spaceId}}"
          bindtap="selectSpace"
          style="left: {{item.position.x}}px; top: {{item.position.y}}px; width: {{item.position.width}}px; height: {{item.position.height}}px;"
        >
          <text class="space-id">{{item.spaceId}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="space-info" wx:if="{{selectedSpace}}">
    <text>车位ID: {{selectedSpace.spaceId}}</text>
    <text>状态: {{selectedSpace.status === 'available' ? '空闲' : '占用'}}</text>
    <text>区域: {{selectedSpace.area}}</text>
    <text>楼层: {{selectedSpace.floorId}}</text>
    <button class="nav-btn" bindtap="navigateToSpace">导航到此车位</button>
  </view>

  <view class="actions">
    <button class="refresh-btn" bindtap="refreshSpaces">刷新</button>
    <button class="find-btn" bindtap="findNearestFreeSpace">找空位</button>
    
    <!-- Canvas渲染引擎控制 -->
    <view wx:if="{{isUsingCanvas}}" class="canvas-controls">
      <view class="control-group">
        <text class="control-label">缩放:</text>
        <button class="scale-btn" data-type="out" bindtap="scaleMap">缩小</button>
        <button class="scale-btn" data-type="in" bindtap="scaleMap">放大</button>
      </view>
      <view class="control-group">
        <text class="control-label">旋转:</text>
        <button class="rotate-btn" data-direction="left" bindtap="rotateMap">←</button>
        <button class="rotate-btn" data-direction="right" bindtap="rotateMap">→</button>
      </view>
      <button class="reset-btn" bindtap="resetView">重置视角</button>
    </view>
    
    <!-- 传统模式控制 -->
    <view wx:else class="traditional-controls">
      <view class="scale-controls">
        <button class="scale-btn" data-type="out" bindtap="scaleMap">缩小</button>
        <button class="scale-btn" data-type="in" bindtap="scaleMap">放大</button>
      </view>
    </view>
    
    <!-- 切换渲染模式按钮 -->
    <button class="toggle-mode-btn" bindtap="toggleRenderMode">
      {{isUsingCanvas ? '使用传统模式' : '使用Canvas模式'}}
    </button>
  </view>
</view>