.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.free-spaces {
  font-size: 28rpx;
  color: #1aad19;
}

.map-container {
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: auto;
}

.parking-map {
  background-color: #e0e0e0;
  position: relative;
}

.parking-space {
  position: absolute;
  border: 2px solid #333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
}

.free {
  background-color: #a5d6a7;
  border-color: #4caf50;
}

.occupied {
  background-color: #ef9a9a;
  border-color: #f44336;
}

.selected {
  border-color: #2196f3;
  border-width: 3px;
  box-shadow: 0 0 10px rgba(33, 150, 243, 0.5);
}

.space-id {
  color: #333;
}

.space-info {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.space-info text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.nav-btn {
  width: 100%;
  background-color: #1aad19;
  color: #fff;
  border: none;
  padding: 15rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0;
  gap: 10rpx;
}

/* Canvas渲染引擎控制界面样式 */
.canvas-controls {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.control-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.control-label {
  font-size: 24rpx;
  color: #333;
  min-width: 60rpx;
}

.canvas-controls .scale-btn,
.canvas-controls .rotate-btn,
.canvas-controls .reset-btn {
  padding: 8rpx 15rpx;
  font-size: 22rpx;
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 8rpx;
  min-width: 60rpx;
}

.canvas-controls .rotate-btn {
  background-color: #2196F3;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.canvas-controls .reset-btn {
  background-color: #FF9800;
  width: 120rpx;
}

/* 传统模式控制界面样式 */
.traditional-controls {
  display: flex;
  align-items: center;
}

.traditional-controls .scale-controls {
  display: flex;
  gap: 10rpx;
}

/* 切换模式按钮样式 */
.toggle-mode-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  background-color: #9C27B0;
  color: white;
  border: none;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

.refresh-btn {
  background-color: #2196f3;
  color: #fff;
  border: none;
  padding: 15rpx 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.find-btn {
  background-color: #4caf50;
  color: #fff;
  border: none;
  padding: 15rpx 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.scale-controls {
  display: flex;
  gap: 10rpx;
}

.scale-btn {
  background-color: #ff9800;
  color: #fff;
  border: none;
  padding: 15rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
}