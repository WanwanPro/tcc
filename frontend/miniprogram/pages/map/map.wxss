.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.free-spaces {
  font-size: 28rpx;
  color: #1aad19;
}

.map-container {
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.parking-map {
  width: 100%;
  height: 100%;
  background-color: #e0e0e0;
  position: relative;
}

.parking-space {
  position: absolute;
  width: 40px;
  height: 40px;
  border: 2px solid #333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
}

.free {
  background-color: #a5d6a7;
  border-color: #4caf50;
}

.occupied {
  background-color: #ef9a9a;
  border-color: #f44336;
}

.space-id {
  color: #333;
}

.space-info {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.space-info text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.nav-btn {
  width: 100%;
  background-color: #1aad19;
  color: #fff;
  border: none;
  padding: 15rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.actions {
  display: flex;
  justify-content: center;
}

.refresh-btn {
  background-color: #2196f3;
  color: #fff;
  border: none;
  padding: 15rpx 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}