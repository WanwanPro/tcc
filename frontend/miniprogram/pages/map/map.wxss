.container {
  padding: 24rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #07c160, #10ad56);
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
  color: #fff;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1px;
}

.free-spaces {
  font-size: 28rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.map-container {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.parking-map {
  background-color: #f0f0f0;
  position: relative;
}

.parking-space {
  position: absolute;
  border: 1px solid rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.free {
  background-color: #e8f5e9;
  border-color: #a5d6a7;
  color: #2e7d32;
}

.occupied {
  background-color: #ffebee;
  border-color: #ef9a9a;
  color: #c62828;
}

.selected {
  border-color: #2196f3;
  border-width: 2px;
  box-shadow: 0 0 15rpx rgba(33, 150, 243, 0.4);
  transform: scale(1.05);
  z-index: 10;
}

.space-id {
  font-size: 22rpx;
}

.space-info {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.space-info text {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #555;
}

.space-info text:first-child {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.nav-btn {
  width: 100%;
  background: linear-gradient(135deg, #2196f3, #1976d2);
  color: #fff;
  border: none;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.3);
}

.actions {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.actions button {
  margin: 0;
}

.primary-actions {
  display: flex;
  gap: 20rpx;
}

.refresh-btn, .find-btn {
  flex: 1;
  border: none;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.refresh-btn {
  background-color: #2196f3;
}

.find-btn {
  background-color: #07c160;
}

/* Canvas Controls */
.canvas-controls {
  background-color: #f9f9f9;
  padding: 16rpx;
  border-radius: 12rpx;
}

.control-group {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.control-group:last-child {
  margin-bottom: 0;
}

.control-label {
  font-size: 26rpx;
  color: #666;
  width: 80rpx;
  font-weight: 500;
}

.scale-btn, .rotate-btn, .reset-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border: none;
  border-radius: 30rpx;
  margin-right: 12rpx;
  color: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.scale-btn {
  background-color: #ff9800;
}

.rotate-btn {
  background-color: #9c27b0;
}

.reset-btn {
  background-color: #607d8b;
  width: auto;
  padding: 10rpx 30rpx;
}

/* Traditional Controls */
.traditional-controls {
  padding: 10rpx 0;
}

.scale-controls {
  display: flex;
  gap: 16rpx;
}

/* Toggle Mode */
.toggle-mode-btn {
  background-color: transparent;
  color: #666;
  font-size: 26rpx;
  padding: 16rpx;
  border: 1px solid #ddd;
  border-radius: 40rpx;
  width: 100%;
}

.toggle-mode-btn:active {
  background-color: #f5f5f5;
}
