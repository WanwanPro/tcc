<view class="container">
  <view class="header">
    <view class="user-info" wx:if="{{isLoggedIn}}">
      <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/profile.png'}}"></image>
      <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
      <text class="meta">{{userInfo.isGuest ? '游客身份' : '已登录用户'}}</text>
    </view>
    <view class="login-prompt" wx:else>
      <text>请登录以享受更多功能</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="viewHistory">
      <text class="menu-text">历史记录</text>
      <text class="arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="systemSettings">
      <text class="menu-text">系统设置</text>
      <text class="arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="login" wx:if="{{!isLoggedIn}}">
      <text class="menu-text">用户登录</text>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="guestLogin" wx:if="{{!isLoggedIn}}">
      <text class="menu-text">游客体验</text>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="refreshProfile" wx:if="{{isLoggedIn}}">
      <text class="menu-text">刷新资料</text>
      <text class="arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="logout" wx:if="{{isLoggedIn}}">
      <text class="menu-text">退出登录</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="app-info">
    <text class="version">{{systemName}} v{{systemVersion}}</text>
    <text class="copyright">© 2026 {{companyName}}</text>
  </view>
</view>
