.container {
  padding: 24rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  background: linear-gradient(135deg, #07c160, #10ad56);
  border-radius: 20rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
  color: #fff;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background-color: #fff;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1px;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-prompt {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
}

.menu-list {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s;
}

.menu-item:active {
  background-color: #fafafa;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: normal;
}

.app-info {
  text-align: center;
  padding: 20rpx;
}

.version {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.copyright {
  font-size: 22rpx;
  color: #bbb;
}
