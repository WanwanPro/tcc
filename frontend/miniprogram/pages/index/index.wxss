.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0;
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.parking-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.welcome {
  font-size: 28rpx;
  color: #666;
}

.stats-card {
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #1aad19;
  display: block;
  margin-bottom: 10rpx;
}

.stats-label {
  font-size: 28rpx;
  color: #666;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 30rpx 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
}

.btn-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 15rpx;
}

.action-btn text {
  font-size: 28rpx;
  color: #333;
}

.notices {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
}

.notice-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.notice-item {
  margin-bottom: 15rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #666;
}