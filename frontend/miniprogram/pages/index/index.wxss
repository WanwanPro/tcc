.container {
  padding: 24rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 48rpx 30rpx;
  background: linear-gradient(135deg, #07c160, #10ad56);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
  color: #fff;
}

.parking-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1px;
}

.welcome {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-card {
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stats-item {
  text-align: center;
  flex: 1;
  position: relative;
}

.stats-item:first-child::after {
  content: '';
  position: absolute;
  right: 0;
  top: 15%;
  height: 70%;
  width: 1px;
  background-color: #eee;
}

.stats-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #07c160;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.stats-label {
  font-size: 26rpx;
  color: #888;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
  padding: 36rpx 20rpx;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
  background-color: #fafafa;
}

.btn-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 20rpx;
}

.action-btn text {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.notices {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.notice-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  background-color: #07c160;
  margin-right: 16rpx;
  border-radius: 4rpx;
}

.notice-item {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f5f5f5;
}

.notice-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.notice-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* ============ 定位卡片样式 ============ */
.location-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.location-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.location-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.location-loading {
  font-size: 24rpx;
  color: #07c160;
}

.location-refresh {
  font-size: 24rpx;
  color: #07c160;
}

.location-body {
  display: flex;
  flex-direction: column;
}

.location-address {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.location-detail {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.location-coords {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.coord-item {
  font-size: 22rpx;
  color: #666;
  font-family: monospace;
}

.coord-divider {
  font-size: 22rpx;
  color: #ccc;
  margin: 0 16rpx;
}

.location-placeholder {
  font-size: 28rpx;
  color: #999;
}


