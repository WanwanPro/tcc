<view class="container">
  <view class="header">
    <text class="title">智能导航</text>
  </view>

  <view class="navigation-info" wx:if="{{isNavigating}}">
    <view class="info-item">
      <text class="label">距离:</text>
      <text class="value">{{distance.toFixed(2)}} 米</text>
    </view>
    <view class="info-item">
      <text class="label">预计时间:</text>
      <text class="value">{{estimatedTime.toFixed(0)}} 秒</text>
    </view>
  </view>

  <view class="map-container">
    <!-- 简化的导航地图展示 -->
    <view class="navigation-map">
      <!-- 起点 -->
      <view 
        class="point start-point" 
        wx:if="{{startPoint}}"
        style="left: {{startPoint.x}}px; top: {{startPoint.y}}px;"
      >
        <text class="point-label">起</text>
      </view>
      
      <!-- 终点 -->
      <view 
        class="point end-point" 
        wx:if="{{endPoint}}"
        style="left: {{endPoint.x}}px; top: {{endPoint.y}}px;"
      >
        <text class="point-label">终</text>
      </view>
      
      <!-- 路径 -->
      <view 
        wx:for="{{path}}" 
        wx:key="index"
        class="path-point"
        style="left: {{item.x}}px; top: {{item.y}}px;"
      ></view>
    </view>
  </view>

  <view class="actions">
    <button 
      class="nav-btn start-btn" 
      wx:if="{{!isNavigating}}"
      bindtap="startNavigation"
    >
      开始导航
    </button>
    <button 
      class="nav-btn end-btn" 
      wx:if="{{isNavigating}}"
      bindtap="endNavigation"
    >
      结束导航
    </button>
  </view>
</view>