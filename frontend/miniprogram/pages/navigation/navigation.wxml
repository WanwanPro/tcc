<!--pages/navigation/navigation.wxml-->
<view class="page-container">
  <view class="canvas-layer {{showComparison ? 'modal-open' : ''}}">
    <canvas
      type="2d"
      id="parkingCanvas"
      class="game-canvas"
      bindtap="onCanvasTap"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      disable-scroll="true"
    ></canvas>
  </view>

  <view class="hud-top-mask"></view>
  <view class="top-nav">
    <text class="nav-title">{{venueTitle}}</text>
  </view>

  <view class="route-card">
    <view class="route-row">
      <view class="dot start"></view>
      <text class="route-label">{{startPointLabel}}</text>
    </view>
    <view class="route-row">
      <view class="dot end"></view>
      <text class="route-label">{{destinationLabel}}</text>
    </view>
  </view>

  <view class="mode-card">
    <view class="mode-back" bindtap="exitSelection">退出选择</view>
    <view class="mode-options">
      <view
        class="mode-pill {{currentAlgorithm === 'astar' ? 'active' : ''}}"
        bindtap="selectAlgorithm"
        data-algo="astar"
      >标准A*</view>
      <view
        class="mode-pill {{currentAlgorithm === 'dynamic-astar' ? 'active' : ''}}"
        bindtap="selectAlgorithm"
        data-algo="dynamic-astar"
      >动态A*</view>
      <view
        class="mode-pill {{currentAlgorithm === 'fast-astar' ? 'active' : ''}}"
        bindtap="selectAlgorithm"
        data-algo="fast-astar"
      >快速A*</view>
    </view>
  </view>
  <view class="bottom-panel">
    <view class="distance-bar">
      <text class="distance-icon dynamic" style="{{directionArrowStyle}}">↑</text>
    </view>
    <view class="action-row triple">
      <view class="action-btn secondary" bindtap="resetSimulation">模拟导航</view>
      <view class="action-btn tool-center" bindtap="showAlgorithmComparison">比</view>
      <view class="action-btn primary" bindtap="startNavigation">{{btnText}}</view>
    </view>
  </view>

  <view class="comparison-modal" wx:if="{{showComparison}}" catchtap="hideComparison">
    <view class="comparison-content" catchtap="preventClose">
      <view class="comparison-header">
        <view class="comparison-title">算法性能对比</view>
        <view class="comparison-close" catchtap="hideComparison">✕</view>
      </view>
      <view class="comparison-table">
        <view class="comparison-row header">
          <view class="col">算法</view>
          <view class="col">路径长度</view>
          <view class="col">扩展节点</view>
          <view class="col">耗时(ms)</view>
        </view>
        <view class="comparison-row {{item.best ? 'best' : ''}}" wx:for="{{comparisonResults}}" wx:key="id">
          <view class="col name">{{item.name}}</view>
          <view class="col">{{item.pathLength || '-'}}</view>
          <view class="col">{{item.nodesExpanded}}</view>
          <view class="col">{{item.computeTime.toFixed(2)}}</view>
        </view>
      </view>
      <view class="comparison-actions">
        <view class="modal-btn" bindtap="runComparison">重新测试</view>
      </view>
    </view>
  </view>
</view>
