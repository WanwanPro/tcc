<!--pages/navigation/navigation.wxml-->
<view class="container">
  <!-- 2.5D 地图画布 -->
  <canvas 
    type="2d" 
    id="mapCanvas" 
    class="map-canvas"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
  ></canvas>

  <!-- 控制面板 -->
  <view class="control-panel">
    <!-- 摇杆容器 -->
    <view class="joystick-wrapper">
      <movable-area class="joystick-area">
        <movable-view 
          class="joystick-handle" 
          direction="all"
          bindchange="onJoystickChange"
          bindtouchend="onJoystickRelease"
          x="{{joystickX}}"
          y="{{joystickY}}"
        >
          <view class="joystick-inner"></view>
        </movable-view>
      </movable-area>
      <view class="joystick-base"></view>
    </view>

    <!-- 信息显示 -->
    <view class="info-panel">
      <text class="info-text">速度: {{speed.toFixed(1)}} m/s</text>
      <text class="info-text">方向: {{bearing.toFixed(0)}}°</text>
    </view>
  </view>

  <!-- 导航控制按钮 -->
  <view class="nav-buttons">
    <button 
      class="nav-btn {{isNavigating ? 'active' : ''}}" 
      bindtap="toggleNavigation"
    >
      {{isNavigating ? '停止导航' : '开始导航'}}
    </button>
    
    <button 
      class="nav-btn secondary" 
      bindtap="selectDestination"
    >
      选择目的地
    </button>

    <button 
      class="nav-btn secondary" 
      bindtap="resetCamera"
    >
      重置视角
    </button>
  </view>

  <!-- 目的地选择器 -->
  <view class="destination-picker" wx:if="{{showDestPicker}}">
    <view class="picker-header">
      <text>选择目的地</text>
      <button class="close-btn" bindtap="closePicker">×</button>
    </view>
    <scroll-view class="picker-list" scroll-y>
      <view 
        class="dest-item" 
        wx:for="{{destinations}}" 
        wx:key="id"
        bindtap="selectDest"
        data-id="{{item.id}}"
      >
        <text class="dest-name">{{item.name}}</text>
        <text class="dest-desc">{{item.desc}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 加载提示 -->
  <view class="loading" wx:if="{{loading}}">
    <text>地图加载中...</text>
  </view>
</view>
