/* pages/navigation/navigation.wxss */
.container {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #000;
  overflow: hidden;
}

/* 地图画布 */
.map-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

/* 控制面板 */
.control-panel {
  position: absolute;
  bottom: 120rpx;
  left: 40rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 摇杆容器 */
.joystick-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.joystick-base {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
}

.joystick-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 200rpx;
  height: 200rpx;
  z-index: 1;
}

.joystick-handle {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.joystick-inner {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.6);
  border: 3rpx solid rgba(255, 255, 255, 0.8);
}

/* 信息面板 */
.info-panel {
  padding: 20rpx 30rpx;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.info-text {
  display: block;
  color: #fff;
  font-size: 24rpx;
  margin: 8rpx 0;
  font-family: 'SF Mono', monospace;
}

/* 导航按钮区域 */
.nav-buttons {
  position: absolute;
  bottom: 40rpx;
  right: 40rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nav-btn {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
}

.nav-btn.active {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.nav-btn.secondary {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.nav-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 目的地选择器 */
.destination-picker {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60vh;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.3);
  z-index: 100;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.picker-header {
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.1);
}

.picker-header text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  border: none;
  font-size: 48rpx;
  color: #666;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.picker-list {
  height: calc(60vh - 140rpx);
  padding: 20rpx;
}

.dest-item {
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.dest-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.dest-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.dest-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 加载提示 */
.loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 40rpx 60rpx;
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  font-size: 28rpx;
  border-radius: 20rpx;
  z-index: 1000;
}
