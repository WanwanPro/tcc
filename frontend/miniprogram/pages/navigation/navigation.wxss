page {
  height: 100%;
  overflow: hidden;
  background: #eef3fb;
}

.page-container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #eef3fb;
}

.canvas-layer {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.canvas-layer.modal-open {
  opacity: 0;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.hud-top-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 460rpx;
  background: linear-gradient(180deg, rgba(238, 243, 251, 0.98) 0%, rgba(238, 243, 251, 0.96) 72%, rgba(238, 243, 251, 0.88) 100%);
  z-index: 18;
  pointer-events: none;
}

.top-nav {
  position: absolute;
  top: 74rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  max-width: 100%;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
}

.route-card,
.mode-card,
.floor-rail,
.bottom-panel {
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
}

.route-card {
  position: absolute;
  top: 178rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.98);
  z-index: 40;
}

.route-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.route-row + .route-row {
  border-top: 1px solid #e2e8f0;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot.start { background: #22c55e; }
.dot.end { background: #ef4444; }

.route-label {
  font-size: 26rpx;
  color: #334155;
  font-weight: 600;
}

.mode-card {
  position: absolute;
  top: 336rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mode-back {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #4f46e5;
}

.mode-options {
  display: flex;
  gap: 10rpx;
  flex: 1;
  justify-content: flex-end;
}

.mode-pill {
  min-width: 120rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
  font-weight: 700;
}

.mode-pill.active {
  background: #2563eb;
  color: #ffffff;
}

.floor-rail {
  position: absolute;
  left: 20rpx;
  top: 420rpx;
  width: 84rpx;
  padding: 12rpx 10rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  z-index: 40;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.rail-mini {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 700;
}

.floor-pill {
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}

.floor-pill.active {
  background: #4f6cf7;
  color: #fff;
}

.bottom-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 30rpx;
  z-index: 45;
}

.distance-bar {
  height: 88rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: linear-gradient(180deg, #5d84f7, #4b6ef0);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.distance-icon {
  font-size: 24rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 96rpx 1fr;
  gap: 18rpx;
  padding: 22rpx 18rpx 18rpx;
  border-radius: 0 0 22rpx 22rpx;
  background: rgba(255, 255, 255, 0.98);
}

.action-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.action-btn.tool-center {
  width: 96rpx;
  min-width: 96rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2563eb;
  border: 1px solid rgba(191, 219, 254, 0.95);
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.12);
}

.action-btn.primary {
  background: #3b82f6;
  color: #fff;
}

.action-btn.secondary {
  background: #e8f3ff;
  color: #2563eb;
}

.comparison-modal {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.comparison-content {
  width: 90%;
  max-height: 80vh;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 30rpx 80rpx rgba(15, 23, 42, 0.22);
}

.comparison-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.comparison-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.comparison-close {
  padding: 8rpx;
  font-size: 40rpx;
  color: #94a3b8;
}

.comparison-table {
  padding: 24rpx;
}

.comparison-row {
  display: flex;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.comparison-row.header {
  background: #f8fafc;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}

.comparison-row.best {
  background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
}

.comparison-row .col {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #0f172a;
}

.comparison-row .col.name {
  text-align: left;
  font-weight: 600;
}

.comparison-actions {
  padding: 24rpx 32rpx 32rpx;
}

.comparison-table,
.comparison-content,
.comparison-header,
.comparison-actions,
.comparison-row,
.comparison-close,
.modal-btn {
  position: relative;
  z-index: 1001;
}

.modal-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
