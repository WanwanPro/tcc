# 运行环境
NODE_ENV=development
PORT=3001

# 数据库配置
MONGODB_URI=mongodb://127.0.0.1:27017/parking_system
UNIFIED_MONGODB_URI=mongodb://127.0.0.1:27017/parking_system

# 跨库同步/兼容脚本使用的管理端数据库地址
SYSTEM_MONGODB_URI=mongodb://127.0.0.1:27017/parking_admin
ADMIN_MONGODB_URI=mongodb://127.0.0.1:27017/parking_admin

# 认证配置
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=24h

# 跨域配置
CORS_ORIGIN=http://localhost:5002

# 管理端接口联调配置
SYSTEM_API_URL=http://localhost:5001/api
SYSTEM_API_TOKEN=
SYSTEM_API_USERNAME=admin
SYSTEM_API_PASSWORD=change_me

# 日志配置
LOG_LEVEL=info

# 上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# 功能开关
ENABLE_CHANGE_STREAMS=0
